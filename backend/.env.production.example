# Azure Production Environment Configuration
# Copy this to .env.production for Azure deployment

# Environment
NODE_ENV=production
PORT=80

# Azure SQL Database with Managed Identity
# Replace with your actual Azure SQL server and database names
AZURE_SQL_SERVER="your-sql-server-name.database.windows.net"
AZURE_SQL_DATABASE="your-database-name"

# JWT Configuration
JWT_SECRET=your-production-jwt-secret-key-make-it-very-secure
JWT_EXPIRE=7d

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./uploads

# CORS - Replace with your actual frontend URL
FRONTEND_URL=https://your-frontend-domain.com

# Azure Logging (optional)
AZURE_LOG_LEVEL=info