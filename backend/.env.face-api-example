# Azure Face API Configuration
# Get these values from your Azure Face API resource in the Azure portal

# Your Azure Face API subscription key
AZURE_FACE_API_KEY=your_face_api_key_here

# Your Azure Face API endpoint URL (includes region)
# Example: https://your-region.api.cognitive.microsoft.com/
AZURE_FACE_API_ENDPOINT=https://your-region.api.cognitive.microsoft.com/

# Person Group ID for your application (can be any string, lowercase, alphanumeric, and hyphens only)
AZURE_FACE_PERSON_GROUP_ID=hadu_lms_students

# Add these to your existing .env file in the backend directory
# Make sure to replace the placeholder values with your actual Azure Face API credentials