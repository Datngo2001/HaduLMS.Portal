// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "linux-musl", "windows"]
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  firstName String
  lastName  String
  password  String
  role      String   @default("STUDENT") // ADMIN, TEACHER, STUDENT
  avatar    String?
  faceId    String?  // Azure Face API person ID
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  createdCourses   Course[]           @relation("CourseCreator")
  enrollments      Enrollment[]
  lessons          Lesson[]           @relation("LessonCreator")
  attendances      Attendance[]
  teachingSessions ClassroomSession[] @relation("SessionTeacher")

  @@map("users")
}

model Course {
  id          String  @id @default(cuid())
  title       String
  description String?
  thumbnail   String?
  isPublished Boolean @default(false)
  price       Float   @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  creatorId   String
  creator     User         @relation("CourseCreator", fields: [creatorId], references: [id])
  lessons     Lesson[]
  enrollments Enrollment[]
  sessions    ClassroomSession[]

  @@map("courses")
}

model Lesson {
  id          String  @id @default(cuid())
  title       String
  content     String?
  videoUrl    String?
  duration    Int?    // in minutes
  order       Int     @default(0)
  isPublished Boolean @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  courseId  String
  course    Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  creatorId String
  creator   User   @relation("LessonCreator", fields: [creatorId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("lessons")
}

model Enrollment {
  id        String           @id @default(cuid())
  status    String           @default("ACTIVE") // ACTIVE, COMPLETED, DROPPED
  progress  Float            @default(0) // percentage 0-100
  enrolledAt DateTime        @default(now())
  completedAt DateTime?

  // Relations
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@map("enrollments")
}

model Classroom {
  id          String   @id @default(cuid())
  name        String
  location    String?
  capacity    Int?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  sessions    ClassroomSession[]

  @@map("classrooms")
}

model ClassroomSession {
  id          String   @id @default(cuid())
  title       String
  startTime   DateTime
  endTime     DateTime
  isActive    Boolean  @default(false)
  checkinCode String?  // Optional QR code for backup check-in
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  classroomId String
  classroom   Classroom    @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  courseId    String?
  course      Course?      @relation(fields: [courseId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  teacherId   String
  teacher     User         @relation("SessionTeacher", fields: [teacherId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  attendances Attendance[]

  @@map("classroom_sessions")
}

model Attendance {
  id              String           @id @default(cuid())
  status          String           @default("PRESENT") // PRESENT, ABSENT, LATE
  checkinTime     DateTime?
  checkinMethod   String?          // FACE_RECOGNITION, QR_CODE, MANUAL
  confidence      Float?           // Face recognition confidence score
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  // Relations
  userId          String
  user            User             @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  sessionId       String
  session         ClassroomSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([userId, sessionId])
  @@map("attendances")
}