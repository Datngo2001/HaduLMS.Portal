// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "./generated"
}

datasource db {
  provider = "sqlserver"
}

model User {
  id          String   @id @default(cuid())
  email       String   @unique
  firstName   String
  lastName    String
  password    String
  role        String   @default("STUDENT") // ADMIN, TEACHER, STUDENT
  avatar      String?
  faceId      String?  // Azure Face API person ID (deprecated - use hasFaceRegistered)
  hasFaceRegistered Boolean @default(false) // Whether user has registered face in blob storage
  faceRegisteredAt DateTime? // When face was registered
  isActive    Boolean  @default(true) // For enabling/disabling users
  phone       String?  // Phone number for search functionality
  classroomId String?  // Optional classroom assignment for students
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  createdCourses   Course[]           @relation("CourseCreator")
  enrollments      Enrollment[]
  lessons          Lesson[]           @relation("LessonCreator")
  attendances      Attendance[]
  teachingSessions ClassroomSession[] @relation("SessionTeacher")
  classroom        Classroom?         @relation("ClassroomStudents", fields: [classroomId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@map("users")
}

model Course {
  id          String  @id @default(cuid())
  title       String
  description String?
  thumbnail   String?
  isPublished Boolean @default(false)
  price       Float   @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  creatorId   String
  creator     User         @relation("CourseCreator", fields: [creatorId], references: [id])
  lessons     Lesson[]
  enrollments Enrollment[]
  sessions    ClassroomSession[]

  @@map("courses")
}

model Lesson {
  id          String  @id @default(cuid())
  title       String
  content     String?
  videoUrl    String?
  duration    Int?    // in minutes
  order       Int     @default(0)
  isPublished Boolean @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  courseId  String
  course    Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  creatorId String
  creator   User   @relation("LessonCreator", fields: [creatorId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("lessons")
}

model Enrollment {
  id        String           @id @default(cuid())
  status    String           @default("ACTIVE") // ACTIVE, COMPLETED, DROPPED
  progress  Float            @default(0) // percentage 0-100
  enrolledAt DateTime        @default(now())
  completedAt DateTime?

  // Relations
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@map("enrollments")
}

model Classroom {
  id          String   @id @default(cuid())
  name        String
  description String?  // Description of the classroom
  location    String?
  capacity    Int?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  sessions    ClassroomSession[]
  students    User[]             @relation("ClassroomStudents")

  @@map("classrooms")
}

model ClassroomSession {
  id          String   @id @default(cuid())
  title       String
  startTime   DateTime
  endTime     DateTime
  isActive    Boolean  @default(false)
  checkinCode String?  // Optional QR code for backup check-in
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  classroomId String
  classroom   Classroom    @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  courseId    String?
  course      Course?      @relation(fields: [courseId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  teacherId   String
  teacher     User         @relation("SessionTeacher", fields: [teacherId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  attendances Attendance[]

  @@map("classroom_sessions")
}

model Attendance {
  id              String           @id @default(cuid())
  status          String           @default("PRESENT") // PRESENT, ABSENT, LATE
  checkinTime     DateTime?
  checkinMethod   String?          // FACE_RECOGNITION, QR_CODE, MANUAL
  confidence      Float?           // Face recognition confidence score
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  // Relations
  userId          String
  user            User             @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  sessionId       String?          // Made optional to allow standalone check-ins
  session         ClassroomSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  // Removed unique constraint since we allow multiple standalone check-ins
  @@map("attendances")
}