# Copy this file to .env and fill in your values

# Database Configuration
DATABASE_URL="sqlserver://localhost;database=hadu_lms_local;user=sa;password=1234;encrypt=true;trustServerCertificate=true;integratedSecurity=false"

# JWT Configuration
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"

# Google OAuth Configuration
GOOGLE_CLIENT_ID="your_google_client_id_here"
GOOGLE_CLIENT_SECRET="your_google_client_secret_here"

# Application Configuration
NODE_ENV="production"
PORT="3001"
FRONTEND_URL="http://localhost:5173"

# Face Recognition Service Configuration
FACE_RECOGNITION_SERVICE_URL="http://face-recognition-service:8001"
SERVICE_PORT="8001"
HOST="0.0.0.0"
CONFIDENCE_THRESHOLD="0.6"
FACE_ENCODINGS_DIR="/app/face_encodings"
DEBUG="false"